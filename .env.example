# simulator-supabase.js 용 (Project Settings > API 에서 확인)
SUPABASE_URL=https://aopqdrdzpeguxwyzvssp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# 쉼표로 구분된 가짜 충전기 ID 목록 (생략 시 기본값 사용)
CHARGERS=CP-1,CP-2,CP-3

# server.js 알림 (선택) — 설정한 채널로만 관리자 폰에 알림이 갑니다. 아무것도 없으면 콘솔에만 출력됩니다.
# ntfy: 폰에 ntfy 앱 설치 후 같은 토픽을 구독 (토픽 이름은 남이 못 맞히게 길고 무작위로)
NTFY_TOPIC=
# Telegram: BotFather로 봇을 만들고, 봇에게 말을 건 뒤 chat id 확인
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 충전기에게 알려줄 Heartbeat 주기(초). 이 주기의 3배 동안 신호가 없으면 통신 두절로 처리합니다.
HEARTBEAT_INTERVAL_SEC=30
